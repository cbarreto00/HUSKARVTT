<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.MesaController">
   <center>
      <Pane fx:id="painelMesa" style="-fx-background-color: #222222;" BorderPane.alignment="CENTER" />
   </center>
   <right>
      <VBox prefWidth="180.0" spacing="10.0" style="-fx-background-color: #333333; -fx-padding: 10;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Menu do Mestre" textFill="WHITE" style="-fx-font-weight: bold;" />
            <Button fx:id="btnAdicionarToken" maxWidth="1.7976931348623157E308" text="Adicionar Token" onAction="#adicionarTokenAleatorio" />
            <Button fx:id="btnLimpar" maxWidth="1.7976931348623157E308" text="Limpar Mesa" onAction="#limparMesa" />
            <Label text="Token Selecionado:" textFill="#aaaaaa" />
            <Label fx:id="lblNomeToken" text="Nenhum" textFill="#00ff00" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
         </children>
      </VBox>
   </right>
</BorderPane>
